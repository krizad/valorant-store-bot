# ==============================================================================
# ValorantStoreCheck - Environment Configuration (.env.example)
# Copy this file to '.env' and fill in your details: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Discord Bot Credentials (REQUIRED)
# Create a bot at https://discord.com/developers/applications
# Enable 'bot' and 'applications.commands' scopes.
# ------------------------------------------------------------------------------
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_application_client_id_here

# ------------------------------------------------------------------------------
# 2. Web Server & Keep-Alive Configuration
# Embedded Express HTTP server for health checks (/health) and Web Auth Portal.
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production
# The public base URL used for the Web Login Portal link in Discord /login
# Example: http://localhost:3000 or https://your-bot-domain.com
PUBLIC_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Valorant Configuration
# Default region for newly added accounts (ap, na, eu, kr)
# ------------------------------------------------------------------------------
DEFAULT_REGION=ap

# ------------------------------------------------------------------------------
# 4. Optional: HenrikDev Unofficial Valorant API Key
# Required only if you want the /profile command (Player Rank, Competitive MMR, Card)
# Obtain a free API key at: https://api.henrikdev.xyz/dashboard/
# ------------------------------------------------------------------------------
HDEV_TOKEN=

# ------------------------------------------------------------------------------
# 5. Database Storage Configuration (Optional)
# Supported options: 'json' (default, flat files in data/) or 'sqlite' (database.sqlite)
# ------------------------------------------------------------------------------
DATABASE_TYPE=json
SQLITE_PATH=data/database.sqlite
