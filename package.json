{
  "name": "valorant-store-bot",
  "version": "2.0.0",
  "description": "VALORANT Daily Store Discord bot with visual 2x2 Canvas banners, SSID web portal authentication, multi-account switching, and keep-alive health endpoints (enhanced from SkinPeek).",
  "main": "SkinPeek.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krizad/valorant-store-bot.git"
  },
  "keywords": [
    "valorant",
    "discord-bot",
    "valorant-store",
    "daily-shop",
    "skinpeek",
    "valorant-skins",
    "canvas",
    "night-market",
    "discordjs"
  ],
  "author": "KriZad <https://github.com/krizad>",
  "contributors": [
    "Giorgio (original SkinPeek creator) <https://github.com/giorgi-o>"
  ],
  "homepage": "https://github.com/krizad/valorant-store-bot#readme",
  "bugs": {
    "url": "https://github.com/krizad/valorant-store-bot/issues"
  },
  "license": "GPL-3.0-or-later",
  "scripts": {
    "start": "node SkinPeek.js",
    "update:assets": "node scripts/updateAssets.js",
    "diag": "node diag.js",
    "package:plesk": "node scripts/package-plesk.js",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "axios": "^1.20.0",
    "discord.js": "^14.27.0",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "fuzzysort": "^2.0.4",
    "node-cron": "^3.0.3",
    "unofficial-valorant-api": "^2.3.1-stable.0"
  }
}
